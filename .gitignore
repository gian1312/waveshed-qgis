htmlcov/
.pytest_cache/
tests/fixtures/output/

# Temp files
*.tmp
*.bak

# Downloaded test terrain data (large, fetched from swisstopo)
data/swissaltiregio_tiles/
# Converted GeoTIFFs / mosaic produced by tools/xyz_to_geotiff.py (large)
data/swissaltiregio_tif/
*.vrt

# Torture test set — fixtures + the QGIS project built by
# tools/make_torture_project.py (GBs of DEMs, buildings, tiles). Regenerate
# with: python3 tools/make_torture_project.py
data/torture/
# QGIS projects and their autosave/backup twins are generated, never committed
*.qgs
*.qgz
*.qgs~
*.qgd

# Local scratch (logs, screenshots)
tmp/

# Local machine-specific config (paths, API keys) — *.local.template.ini is
# the committed template and is deliberately NOT matched by this pattern.
*.local.ini
deploy.local.ini

